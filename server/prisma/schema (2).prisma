generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  locations Location[]
}

model Location {
  id        String   @id @default(uuid())
  userId    String
  name      String
  address   String
  phone     String?
  website   String?
  user      User     @relation(fields: [userId], references: [id])
  reviews   Review[]
  posts     Post[]
  keywords  Keyword[]
  insights  Insight[]
}

model Review {
  id           String   @id @default(uuid())
  locationId   String
  reviewerName String
  rating       Int
  comment      String
  reply        String?
  location     Location @relation(fields: [locationId], references: [id])
}

model Post {
  id         String   @id @default(uuid())
  locationId String
  summary    String
  type       String
  location   Location @relation(fields: [locationId], references: [id])
}

model Keyword {
  id         String   @id @default(uuid())
  locationId String
  keyword    String
  rank       Int
  date       DateTime @default(now())
  location   Location @relation(fields: [locationId], references: [id])
}

model Insight {
  id            String   @id @default(uuid())
  locationId    String
  date          DateTime @default(now())
  views         Int
  searches      Int
  location      Location @relation(fields: [locationId], references: [id])
}