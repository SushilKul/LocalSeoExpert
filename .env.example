# Database Connection
# Use this for local development outside Docker
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/localseoexpert?schema=public"

# Use this for Docker development (uncomment if needed)
# DATABASE_URL="postgresql://postgres:postgres@db:5432/localseoexpert?schema=public"

# Server Configuration
PORT=5000
NODE_ENV=development
HOST=0.0.0.0

# JWT Configuration
JWT_SECRET=dev_jwt_secret_change_in_production

# Email Configuration (optional)
EMAIL_FROM=noreply@example.com
EMAIL_SERVICE=smtp
EMAIL_USER=user
EMAIL_PASSWORD=password
